<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CopilotSdk.Extensions.Hosting</RootNamespace>
    <Description>Integrates the GitHub Copilot SDK with the .NET Generic Host: registers a Microsoft.Extensions.AI IChatClient, owns the CopilotClient lifecycle, and binds configuration.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitHub.Copilot.SDK" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CopilotSdk.Extensions.Hosting.Tests" />
    <InternalsVisibleTo Include="CopilotSdk.Aspire" />
  </ItemGroup>

</Project>
