<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.brunoborges</groupId>
        <artifactId>copilot-spring-boot-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>copilot-spring-boot-test</artifactId>
    <name>Copilot Spring Boot Test</name>
    <description>Scripted in-memory Copilot runtime and Testcontainers support for testing Copilot agents.</description>
    <dependencies>
        <dependency>
            <groupId>io.github.brunoborges</groupId>
            <artifactId>copilot-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessors>
                        <annotationProcessor>com.github.copilot.tool.CopilotToolProcessor</annotationProcessor>
                    </annotationProcessors>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>com.github</groupId>
                            <artifactId>copilot-sdk-java</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests patch fixtures into the named module; open them to the frameworks that reflect on them. -->
                    <argLine>
                        --add-opens io.github.brunoborges.copilot.spring.boot.test/io.github.brunoborges.copilot.test=spring.core,spring.beans,spring.context,spring.aop,spring.boot,spring.boot.autoconfigure,spring.test,spring.boot.test,org.mockito,io.github.brunoborges.copilot.spring.boot.autoconfigure
                        --add-opens io.github.brunoborges.copilot.spring.boot.test/io.github.brunoborges.copilot.test.app=spring.core,spring.beans,spring.context,spring.aop,spring.boot,spring.boot.autoconfigure,spring.test,spring.boot.test,org.mockito,io.github.brunoborges.copilot.spring.boot.autoconfigure
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
