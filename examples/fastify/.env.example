# Copy to .env in this directory. Environment variables override .env entries.
# Leave COPILOT_MODEL unset to use the authenticated runtime's default model.
# COPILOT_MODEL=your-available-model-id
COPILOT_RESPONSE_TIMEOUT_MS=120000
COPILOT_MCP_TIMEOUT_MS=30000
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHANNEL=chromium
PLAYWRIGHT_LAUNCH_TIMEOUT_MS=30000
PLAYWRIGHT_NAVIGATION_TIMEOUT_MS=30000
PLAYWRIGHT_SNAPSHOT_TIMEOUT_MS=10000
