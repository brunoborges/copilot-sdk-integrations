<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Keep shared versions in sync with ../dotnet/Directory.Packages.props. -->
  <ItemGroup Label="Product">
    <PackageVersion Include="Aspire.Hosting" Version="13.6.3" />
    <PackageVersion Include="GitHub.Copilot.SDK" Version="1.0.26" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.6.3" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
