<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <TargetFramework></TargetFramework>
    <RootNamespace>CopilotSdk.Aspire</RootNamespace>
    <Description>Aspire client integration for the GitHub Copilot SDK: connects a service to a Copilot runtime resource and applies Aspire health check and telemetry defaults on top of CopilotSdk.Extensions.Hosting.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../dotnet/src/CopilotSdk.Extensions.Hosting/CopilotSdk.Extensions.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CopilotSdk.Aspire.Tests" />
  </ItemGroup>

</Project>
